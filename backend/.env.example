# Stackduck API (NestJS + Postgres/TimescaleDB) — local dev config.
# Copy to .env and fill in. Never commit real values.
PORT=3001
# Public base URL used when handing out ingest/stripe endpoint URLs.
PUBLIC_API_BASE=http://localhost:3001
# Postgres / TimescaleDB (matches docker-compose.yml service `db`)
DATABASE_URL=postgres://stackduck:stackduck@localhost:5433/stackduck
# Set to "true" when connecting over Railway's public TCP proxy (TLS).
# Leave "false" for local docker-compose and Railway internal networking.
DATABASE_SSL=false
# Require TimescaleDB extension. If the connected Postgres lacks Timescale,
# the API still boots: MetricPoint falls back to a plain table + btree index
# and time_bucket() rollups fall back to date_trunc(). Set to "true" to fail
# fast instead when the extension is missing.
REQUIRE_TIMESCALE=false
# JWT access tokens. There is no JWT_REFRESH_SECRET: refresh tokens are opaque
# random values stored hashed in Postgres, not signed tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# OAuth state (CSRF) signing. Optional — derived from JWT_ACCESS_SECRET when
# blank; set explicitly in production if you prefer independent rotation.
JWT_OAUTH_STATE_SECRET=
# App-level encryption for connector secrets (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# OAuth (callback URLs point at THIS backend, not Firebase — Phase 3 cutover)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback
GOOGLE_IMPORT_CALLBACK_URL=http://localhost:3001/v1/auth/google-import/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/v1/auth/github/callback
GITHUB_IMPORT_CALLBACK_URL=http://localhost:3001/v1/auth/github-import/callback
# CORS allowlist — explicit origins only, never a wildcard. PUBLIC_APP_URL is
# always allowed; add extra comma-separated origins (staging/preview) here.
PUBLIC_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Development-only: allow HTTP webhooks to literal loopback for smoke tests.
# Never honored when NODE_ENV=production; all other destinations require public HTTPS.
ALLOW_LOCAL_ALERT_WEBHOOKS=false
# Alert email delivery via Resend (Alerting Model email channel).
# Leave blank locally to log instead of send; set on Railway/staging.
RESEND_API_KEY=
ALERT_FROM_EMAIL=Stackduck <onboarding@resend.dev>
# Enables POST /v1/internal/jobs/* manual triggers (verification only).
# Leave unset in production — the route 404s when this is empty.
JOBS_TRIGGER_SECRET=
# Kelviq billing (merchant of record, sandbox until go-live).
# Leave unset locally — plans show as not offered, checkout 409s.
KELVIQ_SERVER_API_KEY=
KELVIQ_ENV=sandbox
KELVIQ_PLAN_PRO_MONTHLY=
KELVIQ_PLAN_PRO_YEARLY=
KELVIQ_WEBHOOK_SECRET=


