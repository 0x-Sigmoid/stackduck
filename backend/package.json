{
  "name": "stackduck-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/src/main.js",
    "start:dev": "npm run build && concurrently -k \"tsc --watch -p tsconfig.json\" \"node --watch dist/src/main.js\"",
    "start:prod": "node dist/src/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "typeorm": "typeorm",
    "migrate:firestore": "npm run build && node dist/scripts/firestore-migrate.js",
    "smoke:email": "node scripts/alert-email-smoke.mjs",
    "smoke:unit": "node scripts/unit-check.cjs",
    "smoke:local": "node scripts/local-shakedown.mjs",
    "smoke:alerts": "node scripts/shakedown-alerts.mjs",
    "migrate:run": "npm run build && node dist/src/database/migrate.js",
    "migrate:prod": "node dist/src/database/migrate.js"
  },
  "dependencies": {
    "@kelviq/node-sdk": "^2.9.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.32.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/passport-github2": "^1.2.5",
    "@types/passport-google-oauth20": "^2.0.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "jest": "^30.5.2",
    "typescript": "^7.0.2",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "concurrently": "^10.0.6"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "target": "es2021"
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "type": "commonjs"
}
